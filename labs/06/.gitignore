output/

# Account-identifying run files (caller identity, the account's Lake Formation
# settings saved before the apply and restored after the destroy).
.private/

# Terraform: local state/cache and account-specific backend config.
# (Course material, tfvars, and tfstate are also covered by the root .gitignore.)
terraform/.terraform/
terraform/.terraform.tfstate.lock.info
terraform/backend.hcl
terraform/*.tfplan
**/*.tfstate
**/*.tfstate.backup
**/*.tfstate.*.backup
